@charset "UTF-8";
:root{--paper:#f8f8f4;--white:#fff;--ink:#292e27;--muted:#777d70;--olive:#485341;--olive-light:#eef1e7;--line:#e4e6dc;--gold:#b69a72;--danger:#934c40;--radius:14px;font-family:Inter,"Segoe UI",Arial,sans-serif;font-synthesis:none;color:var(--ink);background:var(--paper);font-size:14px;line-height:1.5;color-scheme:light}
