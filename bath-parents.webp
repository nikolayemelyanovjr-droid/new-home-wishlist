ght:42px;padding:8px 10px}.delete-confirm{background:#fbefe8;border:1px solid #e6cbbf;padding:14px;border-radius:7px;font-size:11px;line-height:1.6;color:#875849;margin-top:20px}.delete-confirm p{margin-bottom:12px}.delete-confirm .text-button{font-size:11px;margin-left:12px}.quiet-note{background:#eeefe7;border:1px solid #e1e5d7;padding:15px;border-radius:8px;color:#858f77;font-size:10px;line-height:1.8}.help-steps{padding:0;margin:0 0 22px;list-style:none}.help-steps>li{display:flex;gap:20px;padding:15px 0}.help-steps>li>span{font-size:12px;color:#99a786;flex-shrink:0}.help-steps h3{font-weight:550;font-size:14px;margin-bottom:6px}.help-steps p{font-size:12px;color:#808c72;line-height:1.8}.house-dialog{width:min(940px,calc(100% - 32px));padding:32px}.house-plans{display:grid;grid-template-columns:1fr 1fr;gap:20px}.house-plans figure{border:1px solid var(--line);border-radius:10px;overflow:hidden;background:#eeeee6}.house-plans img{width:100%;height:275px;object-fit:contain}.house-plans figcaption,.house-gallery figcaption{font-size:10px;color:#7d886c;padding:12px 15px;background:#f1f3e9;border-top:1px solid #e2e6d7}.house-plans figcaption a{text-decoration:underline;text-underline-offset:3px}.house-caption{font-size:11px;color:#8e9781;margin:18px 0 23px}.house-gallery{display:grid;grid-template-columns:1fr 1fr;gap:18px;align-items:start}.house-gallery figure{border-radius:10px;overflow:hidden;border:1px solid var(--line)}.house-gallery img{width:100%;height:225px;object-fit:cover}.house-gallery .wardrobe-figure{grid-column:1/-1;max-width:410px;justify-self:center}.house-gallery .wardrobe-figure img{height:auto;max-height:500px;object-fit:contain;background:#f0ece2}.toasts{position:fixed;bottom:23px;left:50%;transform:translateX(-50%);z-index:9999;max-width:calc(100% - 32px);width:max-content;pointer-events:none}.toast{border:1px solid #6f7e5f;box-shadow:0 8px 24px #28342126;background:var(--olive);color:#fff;border-radius:9px;padding:13px 18px;font-size:12px;display:flex;align-items:center;gap:10px;max-width:500px;line-height:1.6}.toast.error{background:#865845;border-color:#9e6b57}.noscript{position:fixed;inset:120px 20px auto;background:#fff5dc;padding:30px;text-align:center;border:1px solid #e6cda0;z-index:500}
@media(min-width:1500px){.hero{gap:125px}.hero-map{min-height:335px}.hero{padding-top:65px;padding-bottom:55px}}
@media(max-width:1120px){.page-shell,.header-inner{width:calc(100% - 48px)}.top-nav{margin-left:10px;gap:20px}.hero{gap:35px}.wishlist-layout{grid-template-columns:185px minmax(0,1fr);gap:24px}.room-nav-button{font-size:11px;gap:7px;padding:11px 8px}.product-grid{gap:11px}.product-body{padding:12px 10px}.product-body h4{font-size:12px}.reserve-button{font-size:9px}.category-progress{width:170px}.product-art{height:135px}.product-art::after{top:104px}.sort-wrap{max-width:117px}.home-story{gap:18px}.home-story h2{font-size:26px}.story-image{height:210px}}
@media(max-width:900px){.hero{gap:28px}.hero-map{min-height:270px}.hero-copy>p{font-size:13px}.hero-actions{gap:18px}h1{font-size:46px;letter-spacing:-2.6px}.top-nav{display:none}.header-inner{height:75px}.wishlist-layout{grid-template-columns:160px minmax(0,1fr);gap:20px}.product-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.room-nav-button{grid-template-columns:15px 1fr 25px;padding:10px 6px;font-size:10px;gap:5px}.category-progress{width:150px}.category-title{gap:7px}.category-heading h3{font-size:16px}.section-index{font-size:8px}.category-subtitle{font-size:9px;margin-left:20px}.filters{flex-wrap:wrap}.search-field{flex-basis:100%}.select-wrap{flex:1}.select-wrap select{width:100%;max-width:none}.sort-wrap{max-width:none}.stat-card{padding:18px 20px}.stat-number{font-size:30px}.stat-caption{font-size:10px}.stat-number small{font-size:12px}.home-story{grid-template-columns:.9fr 1.1fr}.story-kitchen{display:none}.footer-inner{gap:15px}.footer-inner>span{font-size:9px;max-width:240px}.product-art{height:155px}.product-art::after{top:115px}}
@media(max-width:680px){.page-shell,.header-inner{width:calc(100% - 32px)}.mode-banner{font-size:10px;padding:8px 16px}.mode-banner button{font-size:10px}.header-inner{height:70px;gap:8px}.brand{font-size:18px;gap:8px;letter-spacing:-.8px}.brand img{width:30px;height:30px}.header-actions{gap:9px}.my-button{font-size:10px;gap:5px;padding:8px;min-height:35px}.my-button .icon{width:13px;height:13px}.count-badge{font-size:9px;min-width:17px;height:17px}.profile-button{width:30px;height:30px}.profile-button .icon{width:14px;height:14px}.hero{grid-template-columns:1fr;gap:24px;padding:32px 0 24px}.eyebrow{font-size:9px;letter-spacing:1.6px}h1{font-size:49px;line-height:1.08;margin:19px 0 17px;letter-spacing:-2.8px}h1 em{letter-spacing:-2px}.hero-copy>p{font-size:12px;line-height:1.85}.hero-actions{margin-top:22px;gap:23px}.hero-actions .button{min-height:41px;padding:10px 15px;font-size:11px;gap:23px}.hero-actions .text-button{font-size:11px}.hero-map{min-height:0;height:207px}.courtyard-map{object-fit:cover;object-position:center 46%;max-height:none;width:100%;height:207px}.mini-plan{width:86px;right:17px;bottom:50px}.map-caption{padding:10px 15px;font-size:10px}.overview{gap:10px}.stat-card{padding:14px 13px 13px;border-radius:10px}.stat-top{font-size:8px;letter-spacing:.7px;gap:3px;align-items:flex-start;min-height:24px}.stat-top .icon{width:14px;height:14px}.stat-numbers{display:block;margin:4px 0 11px}.stat-number{font-size:28px;letter-spacing:-1px;line-height:1.3}.stat-number small{font-size:10px;letter-spacing:0;margin-left:4px}.stat-caption{text-align:left;margin-top:5px;font-size:9px;min-height:25px}.stat-bottom{font-size:8px;gap:4px;flex-wrap:wrap;margin-top:8px}.progress{height:4px}.stat-bottom .reserved-dot{width:4px;height:4px;margin-right:3px}.wishlist-intro{margin:19px 0 23px;align-items:flex-start;gap:10px}.wishlist-intro p{font-size:10px;line-height:1.75;align-items:flex-start;gap:7px}.wishlist-intro .little-heart{font-size:18px;line-height:1.2}.wishlist-intro>.text-button{white-space:nowrap;font-size:9px;margin-top:0}.wishlist-layout{display:block}.room-sidebar{position:static;margin:0 -16px 27px}.aside-heading{font-size:8px;margin:0 16px 10px}.room-sidebar #room-nav{display:flex;overflow:auto;gap:7px;padding:0 16px 8px;scrollbar-width:thin;scrollbar-color:#d5dcc9 transparent}.room-nav-button{display:flex;align-items:center;gap:6px;white-space:nowrap;width:auto;flex-shrink:0;border:1px solid var(--line);background:#fff;padding:8px 10px;margin:0;font-size:10px;border-radius:7px}.room-nav-button>.icon{width:13px;height:13px;margin:0}.room-nav-button .nav-count{font-size:9px;align-self:center;margin-top:0}.nav-mini-progress{display:none}.room-nav-all{margin:0}.room-plan-button{display:none}.list-heading{margin-bottom:15px}.list-heading h2{font-size:27px}.section-eyebrow{font-size:7px;margin-bottom:5px}.connection-state{font-size:8px;max-width:145px}.filters{gap:7px;margin-bottom:24px}.search-field{height:39px}.search-field input{font-size:11px}.select-wrap select{font-size:10px;padding:9px 8px;min-height:36px}.product-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.product-art{height:137px}.product-art .product-outline{width:59px;height:59px}.product-art::after{top:103px;width:65px;left:calc(50% - 32px)}.product-status{font-size:7px;top:8px;left:8px;padding:3px 5px}.product-art .photo-note{font-size:7px;right:8px;bottom:7px}.product-quantity{font-size:8px;bottom:7px;left:8px}.product-body{padding:11px 10px}.product-body h4{font-size:11px;min-height:32px;line-height:1.45;margin-bottom:5px}.product-note{font-size:9px;min-height:14px;margin-bottom:9px}.product-store{font-size:7px;letter-spacing:0}.product-price{font-size:15px;letter-spacing:-.3px}.product-price.unknown{font-size:10px}.price-detail{font-size:7px;min-height:11px}.card-actions{gap:6px;margin-top:12px}.reserve-button{font-size:8px;padding:7px 2px;min-height:32px;gap:4px}.reserve-button .icon{width:10px;height:10px}.shop-button{width:29px;height:32px}.shop-button .icon{width:11px;height:11px}.no-shop{font-size:7px;max-width:37px}.category-heading{gap:12px;margin-bottom:13px}.category-title{gap:7px}.category-heading h3{font-size:15px}.section-index{font-size:7px}.category-subtitle{font-size:8px;line-height:1.6;max-width:150px}.category-progress{width:130px;flex-shrink:0;font-size:7px;gap:4px;max-width:43%}.category-money{font-size:7px}.category-progress .progress{height:2px}.category-section{margin-bottom:29px}.admin-toolbar{padding:10px 12px}.admin-toolbar>div:last-child{gap:6px}.admin-toolbar .button{font-size:9px;padding:6px 8px;min-height:32px}.admin-toolbar span{font-size:8px}.admin-toolbar strong{font-size:10px}.home-story{margin:38px 0 33px;padding-top:27px;grid-template-columns:1fr;gap:20px}.home-story h2{font-size:28px;line-height:1.2}.home-story h2 br{display:none}.home-story .eyebrow{max-width:none;font-size:8px}.home-story .text-button{font-size:10px}.story-image{height:230px}.story-kitchen{display:none}.site-footer{padding:20px 0}.footer-inner{flex-wrap:wrap;gap:13px}.footer-brand{font-size:13px}.footer-brand img{width:24px;height:24px}.footer-inner>span{order:3;font-size:9px;flex-basis:100%;max-width:none}.footer-inner .text-button{font-size:9px;margin-left:auto}.modal{padding:23px}.dialog-top{margin-bottom:20px}.dialog-top h2{font-size:25px}.dialog-top .eyebrow{font-size:8px}.side-dialog{padding:25px 20px;border-radius:0}.house-dialog{padding:22px;width:calc(100% - 20px);max-height:93dvh}.house-dialog .dialog-top h2{font-size:23px}.house-plans{gap:12px;grid-template-columns:1fr}.house-plans img{height:225px}.house-plans figcaption,.house-gallery figcaption{padding:9px 12px;font-size:9px}.house-gallery{grid-template-columns:1fr;gap:15px}.house-gallery img{height:auto}.house-gallery .wardrobe-figure{max-width:100%}.input-with-button{gap:5px}.input-with-button .button{font-size:9px;padding:9px 6px}.help-steps>li{gap:15px}.help-steps h3{font-size:13px}.help-steps p{font-size:11px}.toasts{bottom:17px}.toast{font-size:11px;padding:12px 15px}.profile-note{font-size:12px}.mine-total{padding:17px}.mine-amount{font-size:28px}.house-caption{font-size:10px}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}
@media print{.mode-banner,.site-header,.room-sidebar,.filters,.admin-toolbar,.hero-actions,.wishlist-intro,.site-footer,.card-actions,.home-story,.edit-item-button{display:none!important}.page-shell{width:100%}.hero{padding:0 0 20px;gap:20px}h1{font-size:35px}.hero-map{min-height:170px}.overview{margin-bottom:25px}.wishlist-layout{display:block}.product-grid{grid-template-columns:repeat(3,1fr)}.product-card{break-inside:avoid}.product-art{height:80px}.product-art .product-outline{width:40px;height:40px}.category-section{break-inside:avoid}.connection-state{display:none}}
.category-heading h3,#items-root{scroll-margin-top:20px}
/* Подписи действий остаются видимыми: ссылка в магазин не прячется за значком. */
.card-actions{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
.shop-button{display:flex;align-items:center;justify-content:center;width:auto;padding:0 6px;gap:5px;font-size:9px;white-space:nowrap}
.shop-button .icon{width:11px;height:11px}
.no-shop{max-width:none;min-height:34px;display:flex;align-items:center;justify-content:center;text-align:center;font-size:9px}
@media(max-width:680px){.card-actions{grid-template-columns:1fr;gap:6px}.reserve-button{font-size:10px}.shop-button{width:100%;height:30px;font-size:9px}.no-shop{font-size:8px;min-height:30px}.product-body h4{font-size:12px}.product-price.unknown{font-size:11px}.category-progress{width:148px;max-width:44%;font-size:9px}.category-money{font-size:8px}.category-subtitle{font-size:9px}.category-progress .metric-label{flex-wrap:wrap;gap:1px 5px}}

/* Apartment gallery: original plans and complete, uncropped furniture views. */
.welcome-note{display:grid;grid-template-columns:180px minmax(0,1fr);gap:30px;margin-bottom:28px;padding:29px 32px;background:#eef1e7;border:1px solid #e0e5d7;border-radius:12px}
.welcome-note h2{font-family:Georgia,"Times New Roman",serif;font-size:28px;font-weight:400;line-height:1.25;letter-spacing:-.6px;color:var(--olive);padding-top:2px}
.welcome-copy{max-width:890px;font-size:13px;line-height:1.85;color:#616b57}
.welcome-copy p+p{margin-top:13px}.welcome-signoff{color:var(--olive)}
@media(max-width:680px){.welcome-note{grid-template-columns:1fr;gap:14px;padding:22px 20px;margin-bottom:22px}.welcome-note h2{font-size:27px}.welcome-copy{font-size:12px;line-height:1.85}.welcome-copy p+p{margin-top:14px}}
.house-dialog{width:min(1040px,calc(100% - 32px));padding:0;max-height:92dvh;scrollbar-width:thin}
.house-header{position:sticky;top:0;z-index:3;padding:24px 30px 0;background:var(--paper);border-bottom:1px solid var(--line)}
.house-header .dialog-top{margin:0 0 18px}.house-header .dialog-top h2{font-size:28px}.house-header .icon-button{background:var(--paper)}
.house-nav{display:flex;gap:5px;overflow-x:auto;padding:0 0 12px;scrollbar-width:thin}
.house-nav button{font-size:11px;padding:9px 13px;white-space:nowrap;border:1px solid var(--line);border-radius:6px;background:#fff}
.house-nav button:hover{background:var(--olive-light);border-color:#c6cfba}
.house-content{padding:0 30px 30px}.house-stage{padding-top:30px;scroll-margin-top:155px}
.house-stage+.house-stage{margin-top:30px;border-top:1px solid var(--line)}
.house-section-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:20px}
.house-section-heading h3{font-size:27px;line-height:1.25;letter-spacing:-.8px;font-weight:500;margin-top:9px}
.gallery-note{font-size:10px;color:var(--muted);max-width:160px;text-align:right;line-height:1.6}
.gallery-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;align-items:start}
.gallery-wide{grid-column:1/-1}.gallery-card{min-width:0;background:#fff;border:1px solid var(--line);border-radius:10px;overflow:hidden}
.gallery-preview{position:relative;display:block;width:100%;padding:0;background:white;cursor:zoom-in}
.gallery-preview img{width:100%;height:auto;object-fit:contain}
.gallery-preview:focus-visible{outline-offset:-4px}
.view-hint{position:absolute;right:12px;bottom:12px;display:flex;align-items:center;gap:12px;padding:6px 10px;background:#fffffff0;border:1px solid #e2e6dc;border-radius:5px;font-size:11px;color:var(--olive)}
.gallery-card figcaption{font-size:11px;line-height:1.6;color:#737c67;padding:11px 15px;border-top:1px solid var(--line);background:#f1f3eb}
.plan-card .gallery-preview{padding:15px}.plan-card img{max-height:580px;object-fit:contain}
.house-details{margin-top:18px;border:1px solid var(--line);border-radius:9px;background:#f0f2e9;overflow:hidden}
.house-details summary{display:flex;align-items:center;justify-content:space-between;gap:15px;cursor:pointer;padding:16px 18px;font-size:12px;list-style:none}
.house-details summary::-webkit-details-marker{display:none}.house-details summary>span{font-size:20px;line-height:1;color:#8b967c;transition:transform .2s}.house-details[open] summary>span{transform:rotate(45deg)}
.house-details>.gallery-grid{padding:0 16px 16px}.house-details .gallery-card figcaption{font-size:10px}
.wardrobe-gallery{grid-template-columns:1.35fr 1fr}.wardrobe-tall{grid-column:2;grid-row:1/3}
.house-location{display:grid;grid-template-columns:230px 1fr;gap:28px;align-items:center;margin-top:42px;border-top:1px solid var(--line);padding-top:28px}
.house-location>img{border-radius:8px;border:1px solid var(--line)}.house-location h3{font-size:23px;font-weight:500;letter-spacing:-.6px;margin:7px 0 10px}.house-location .text-button{font-size:11px}
.image-dialog{width:calc(100% - 32px);height:92dvh;max-height:92dvh;padding:0;overflow:hidden;background:#f8f8f4}
.image-dialog[open]{display:flex;flex-direction:column}.image-toolbar{display:flex;align-items:center;gap:20px;padding:17px 22px;border-bottom:1px solid var(--line);flex-shrink:0}
.image-toolbar h2{font-size:16px;font-weight:500;line-height:1.4;letter-spacing:-.3px;margin:0;flex:1}.image-toolbar>.icon-button{margin:0}
.image-zoom{display:flex;gap:4px}.image-zoom button{min-height:34px;border:1px solid var(--line);border-radius:5px;padding:6px 10px;font-size:11px}
.image-zoom button[aria-pressed=true]{background:var(--olive);color:white;border-color:var(--olive)}
.image-frame{flex:1;min-height:0;overflow:auto;overscroll-behavior:contain;background:white;outline-offset:-3px}
.image-frame img{height:auto;max-width:none;max-height:none;margin:0 auto;display:block}
@media(max-width:680px){
 .house-dialog{width:calc(100% - 16px);max-height:94dvh;padding:0;border-radius:12px}
 .house-header{padding:18px 18px 0}.house-header .dialog-top h2{font-size:23px;max-width:235px}.house-header .dialog-top{margin-bottom:14px}
 .house-nav{margin-right:-18px;padding-right:18px;gap:6px}.house-nav button{font-size:10px;padding:8px 11px}
 .house-content{padding:0 16px 24px}.house-stage{padding-top:24px;scroll-margin-top:148px}.house-stage+.house-stage{margin-top:26px}
 .house-section-heading{display:block;margin-bottom:15px}.house-section-heading h3{font-size:24px}.house-section-heading .eyebrow{font-size:8px}
 .gallery-note{display:block;max-width:none;text-align:left;font-size:9px;margin-top:10px}.gallery-grid{grid-template-columns:1fr;gap:13px}
 .gallery-card figcaption{font-size:10px;padding:10px 12px}.view-hint{font-size:9px;right:8px;bottom:8px;padding:5px 8px}.plan-card .gallery-preview{padding:8px}.plan-card img{max-height:none}
 .house-details summary{padding:14px 13px;font-size:11px}.house-details>.gallery-grid{padding:0 10px 10px}
 .wardrobe-gallery{grid-template-columns:1fr}.wardrobe-tall{grid-column:auto;grid-row:auto}.house-location{grid-template-columns:105px 1fr;gap:16px;margin-top:28px;padding-top:24px}
 .house-location .eyebrow{font-size:7px;letter-spacing:1px}.house-location h3{font-size:19px}.house-location .text-button{font-size:10px}
 .image-dialog{width:calc(100% - 12px);height:95dvh;max-height:95dvh;border-radius:10px}.image-toolbar{flex-wrap:wrap;gap:12px;padding:14px}
 .image-toolbar h2{font-size:14px;flex-basis:calc(100% - 50px)}.image-toolbar>.icon-button{order:1}.image-zoom{order:2;width:100%}.image-zoom button{flex:1;min-height:36px}
}
