import test from 'node:test';
import assert from 'node:assert/strict';
import { storeURL, parseProduct } from '../supabase/functions/product-metadata/parse.js';
test('Цена, фото и название из открытой карточки',()=>{
  const data=parseProduct(`<meta property="og:title" content="Стол &amp; стул"><meta content="https://example.com/image.jpg" property="og:image"><script type="application/ld+json">{"@type":"Product","name":"Стол","offers":{"@type":"Offer","price":"1299.90","priceCurrency":"RUB"}}</script>`,'https://market.yandex.ru/product');
  assert.equal(data.title,'Стол & стул');assert.equal(data.unit_price,1299.9);assert.equal(data.currency,'RUB');assert.equal(data.image_url,'https://example.com/image.jpg');
});
test('Диапазон и зарубежная валюта не принимаются за точную цену в рублях',()=>{
  const make=offer=>`<meta property="product:price:amount" content="999"><meta property="product:price:currency" content="RUB"><script type="application/ld+json">${JSON.stringify({'@type':'Product',offers:offer})}</script>`;
  assert.equal(parseProduct(make({'@type':'AggregateOffer',lowPrice:'100',highPrice:'300',priceCurrency:'RUB'}),'https://market.yandex.ru/').unit_price,null);
  assert.equal(parseProduct(make([{'@type':'Offer',price:10,priceCurrency:'RUB'},{'@type':'Offer',price:20,priceCurrency:'RUB'}]),'https://market.yandex.ru/').unit_price,null);
  assert.equal(parseProduct(make({'@type':'Offer',price:200,priceCurrency:'USD'}),'https://market.yandex.ru/').unit_price,null);
});
test('Необязательный импорт не принимает внутренние адреса и опасные редиректы',()=>{
  assert.equal(storeURL('https://market.yandex.ru/cc/test').hostname,'market.yandex.ru');
  for(const url of ['http://127.0.0.1','https://127.0.0.1','https://market.yandex.ru.evil.example/','https://user:pass@market.yandex.ru/','file:///etc/passwd','https://market.yandex.ru:444/']) assert.throws(()=>storeURL(url));
});
test('Защитная страница магазина не становится карточкой товара',()=>{
  assert.throws(()=>parseProduct('<title>Вы не робот?</title>','https://market.yandex.ru/showcaptcha'),/проверку/);
});
